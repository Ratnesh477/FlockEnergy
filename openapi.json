{
  "openapi": "3.1.0",
  "info": {
    "title": "Flock Energy - Urja Meter Ops API",
    "description": "Clean, resilient, modern REST API proxy layer over legacy Urja Meter Ops portal.\n\nFeatures:\n- Automated Better-Auth session persistence & seamless re-authentication\n- Reverse-engineered internal JSON and HMAC-SHA256 signed export APIs\n- BeautifulSoup4 fallback HTML scraper for legacy pages\n- 7-tier distribution network hierarchy tree with automatic anomaly healing\n- In-memory query engine supporting multi-attribute & geographic proximity search\n- Normalized timestamps (ISO 8601) and parsed floating-point metrics",
    "version": "1.0.0"
  },
