        ],
        "summary": "Service Health Check",
        "description": "Verify API service health, legacy portal reachability, and cache freshness.",
        "operationId": "health_check_health_get",
        "responses": {
          "200": {
            "description": "Service status and legacy portal connectivity",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        }
      }
    },
